# --- Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# --- Phaze Enterprise API (control plane) ---
# Needs an administrator account: https://admin.phaze.app/settings
# Help: https://help.phaze.app/articles/6515713992-the-phaze-api
PHAZE_API_KEY=

# --- Phaze MCP (hands). Served by the Phaze app on this computer once the experimental
# MCP feature is on in client settings. Ideally signed in as a dedicated agent account.
# Help: https://help.phaze.app/articles/6522930271-the-phaze-mcp-server
PHAZE_MCP_URL=http://127.0.0.1:41010/mcp

# --- Slack (intake + escalation) ---
# Bot must be invited to the help channel(s) and the escalation channel.
SLACK_BOT_TOKEN=
# App-level token (xapp-...) with connections:write, for Socket Mode.
SLACK_APP_TOKEN=
# Channel ID where employees post tickets (the listener watches this).
SLACK_HELP_CHANNEL=
# Channel ID of the escalation channel where technicians get paged.
SLACK_ESCALATION_CHANNEL=

# --- Guardrails ---
HUMAN_JOIN_TIMEOUT_MIN=15
MAX_TURNS=80
HUMAN_REPLY_TIMEOUT_MIN=15
HUMAN_SESSION_TIMEOUT_MIN=120
MAX_HANDOFFS=3
MAX_CONCURRENT_TICKETS=2
